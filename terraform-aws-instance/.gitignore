# ------------------------------------------------------------------------
# Official Terraform .gitignore Template
# ------------------------------------------------------------------------

# Local .terraform directories (contains downloaded provider plugins)
**/.terraform/*

# .tfstate files (contains cleartext secrets and live state details)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variable files containing sensitive credentials/secrets
*.tfvars
*.tfvars.json

# Exclude override files (used for quick local developer adjustments)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control (optional negation)
# !example_override.tf

# Include micro-managed auto-vars if absolutely needed (use with caution)
# !.auto.tfvars

# CLI configuration files
.terraformrc
terraform.rc
